---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';
import FormReserva from '../components/FormReserva.astro';

const passeio = {
  titulo: "Translado Hotel - Skyglass - Hotel",
  subtitulo: "Transporte Executivo com Ar Condicionado",
  categoria: "RECEPTIVO",
  preco: 160.00,
  avaliacao: 5.0,
  totalAvaliacoes: 8,
  parcelas: "Promoção",
  descricao: "Aproveite a comodidade do transporte executivo para visitar a Skyglass Canela, a primeira plataforma de aço e vidro da América Latina! Com vistas espetaculares do Vale da Ferradura, nossa equipe garante um trajeto seguro e confortável para que você aproveite ao máximo essa experiência única na Serra Gaúcha. Com nosso serviço de translado, você não se preocupa com o trajeto e aproveita cada momento.",
  inclusos: [
    "Transporte de ida e volta (Hotel - Skyglass - Hotel)",
    "Buscamos e deixamos no seu hotel em Gramado ou Canela",
    "Veículo executivo com ar condicionado",
    "Motorista experiente",
    "Conforto e segurança total"
  ],
  naoInclusos: [
    "Ingresso para a Skyglass Canela",
    "Refeições e bebidas",
    "Despesas pessoais"
  ],
  duracao: "De acordo com sua permanência no parque",
  horarios: ["A combinar"],
  galeria: [
    "/images/skyglass/skyglass.jpg"
  ],
  tags: ["Ida e Volta", "Executivo", "Ar Condicionado", "Promoção"]
};

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo}. Valor: R$ ${passeio.preco.toFixed(2).replace('.', ',')} (ida e volta).`;
const whatsappUrl = `https://wa.me/5554999411358?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} | Serra Nevada Gramado Turismo - Canela RS`}
  description="Translado executivo para o Skyglass Canela! Serviço de ida e volta com conforto total e motorista experiente com a Serra Nevada Gramado Turismo!"
  keywords={['translado Skyglass Canela', 'transporte executivo Canela', 'serviço translado Gramado', 'ida e volta Skyglass', 'Serra Nevada Gramado Turismo']}
  image={passeio.galeria[0]}
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-48 lg:h-[350px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-attachment: fixed; background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-medium rounded-full mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl text-gray-200">{passeio.subtitulo}</p>
        </div>
      </div>

      <!-- Divisor Boleado Suave -->
      <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-20">
        <svg 
          viewBox="0 0 1200 120" 
          preserveAspectRatio="none" 
          class="relative block w-[calc(100%+1.3px)] h-[30px] lg:h-[50px]"
        >
          <path d="M0,0 C300,120 900,120 1200,0 L1200,120 L0,120 Z" class="fill-white dark:fill-gray-900"></path>
        </svg>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Conteúdo Principal -->
        <div class="lg:col-span-2">

          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre esta atividade</h2>
            <p class="text-gray-700 leading-relaxed mb-6">{passeio.descricao}</p>
            
            <div class="bg-primary-50 p-6 rounded-lg">
              <h4 class="font-bold text-primary-800 mb-4 flex items-center">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Detalhes do Serviço
              </h4>
              <ul class="text-gray-700 space-y-3">
                <li class="flex items-start">
                  <span class="font-bold mr-2">•</span>
                  <span><strong>Conforto:</strong> Carro executivo com ar condicionado para sua melhor experiência.</span>
                </li>
                <li class="flex items-start">
                  <span class="font-bold mr-2">•</span>
                  <span><strong>Praticidade:</strong> Buscamos e deixamos diretamente no seu hotel em Gramado ou Canela.</span>
                </li>
                <li class="flex items-start">
                  <span class="font-bold mr-2">•</span>
                  <span><strong>Flexibilidade:</strong> Horários a combinar de acordo com sua necessidade.</span>
                </li>
                <li class="flex items-start">
                  <span class="font-bold mr-2">•</span>
                  <span><strong>Economia:</strong> Valor promocional de R$ 160,00 para o trajeto de ida e volta.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que está incluso</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- O que NÃO está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que NÃO está incluso</h3>
            <ul class="space-y-2">
              {passeio.naoInclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tags -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Destaques</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">{tag}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <!-- Card de Reserva -->
          <div class="bg-white border border-gray-200 rounded-xl p-6 sticky top-24">
              <FormReserva
                passeioNome={passeio.titulo}
                passeioParcelas={passeio.parcelas}
                passeioPreco={passeio.preco}
                passeioPreco1={passeio.preco}
                passeioPreco2={passeio.preco}
                passeioLabel1="Preço"
                passeioLabel2="Preço"
                passeioTemFaixas={false}
                passeioDuracao={passeio.duracao}
                passeioHorarios={passeio.horarios}
                passeioCategoria={passeio.categoria}
              />

          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
