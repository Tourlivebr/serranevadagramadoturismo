---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';
import FormReserva from '../components/FormReserva.astro';

const whatsappAgencia = "5554996474071";

const passeio = {
  titulo: "Tour Linha Bella",
  subtitulo: "Uma viagem pela história, cultura e sabores da Serra Gaúcha",
  categoria: "CULTURA",
  preco: 319.00,
  avaliacao: 4.9,
  totalAvaliacoes: 187,
  parcelas: "Por pessoa:",
  descricao: "Na Cantina Linha Bella é impossível resistir ao pecado da gula. O restaurante é inspirado nos antigos porões Italianos onde as famílias reuniam-se para festejar e se fartar. Nosso Buffet conta com uma vasta variedade de saladas, 4 tipos de massas, 3 tipos de molhos, galeto assado, galinha caipira, costela suína, polenta mole, arroz, feijão, lasanha, além de deliciosas sobremesas que trazem lembranças dos sabores da nona.",
  descricaoExtra: "Importante: O almoço ocorre junto com o mesmo do PASSEIO LINHA BELLA, um encontro com pessoas de vários lugares com muita diversão, dança e brincadeiras. É possível adquirir somente o almoço, sem participar do passeio.",
  inclusos: [
    "Transporte ida e volta ao seu local de hospedagem",
    "Guia especializado compartilhando curiosidades e histórias da região",
    "Visitação em uma vinícola com degustação de vinhos e sucos",
    "Conheça o Casarão centenário da família Marcon com degustação de bolachas, geléias e doce de leite feito pela nona",
    "Explore o Bodegão da Família Bof, marco zero de Gramado com degustação de salames, queijos e copas",
    "Almoço típico italiano na Cantina Linha Bella, com música, dança e uma mesa farta de delícias"
  ],
  roteiro: [
    "Visitação em uma vinícola da Serra Gaúcha com degustação de vinhos e sucos produzidos na região, acompanhada de explicação sobre o processo de elaboração e a história da vitivinicultura familiar italiana.",
    "Conheça o Casarão centenário da família Marcon, propriedade histórica que preserva a arquitetura e os costumes da imigração. Degustação de bolachas artesanais, geléias caseiras e doce de leite feito pela nona.",
    "Explore o Bodegão da Família Bof, marco zero de Gramado e ponto de referência da colonização. Degustação de salames artesanais, queijos maturados e copas, acompanhadas de pão caseiro e conservas.",
    "Almoço típico italiano na Cantina Linha Bella, inspirado nos antigos porões italianos. Buffet completo com saladas, 4 tipos de massas, 3 tipos de molhos, galeto assado, galinha caipira, costela suína, polenta mole, arroz, feijão, lasanha e deliciosas sobremesas, ao som de música ao vivo e danças tradicionais italianas."
  ],
  duracao: "Das 07:30 às 15:00 (aproximadamente 7 horas e 30 minutos)",
  horarios: ["07:30 (saída da hospedagem em Gramado / Canela)"],
  galeria: [
    "https://site-assets.planne.com.br/clients/linhabella/home-prevideo.jpg",
    "https://site-assets.planne.com.br/clients/linhabella/noiteitaliana.jpg",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=vinicola%20familia%20italiana%20serra%20gaucha%20gramado%20canela%20barris%20de%20vinho%20madeira%20rustico%20luz%20quente%20fotografia%20realista&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=mesa%20farta%20almoço%20italiano%20cantina%20gramado%20galeto%20massas%20saladas%20lasanha%20polenta%20decoracao%20rustica%20italiana%20pessoas%20felizes%20fotografia&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=casa%20antiga%20colonial%20italiana%20casarao%20madeira%20centenario%20gramado%20serra%20gaucha%20jardim%20flores%20dia%20ensolarado&image_size=landscape_16_9",
    "https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=bodegao%20colonial%20salames%20queijos%20copas%20conservas%20familia%20italiana%20gramado%20marco%20zero%20madeira%20rustica&image_size=landscape_16_9"
  ],
  tags: [
    "Reserva antecipada obrigatória (48 horas)",
    "Lugares limitados",
    "Almoço coletivo interativo com música e dança",
    "Degustações inclusas durante todo o passeio",
    "Transporte ida e volta na hospedagem",
    "Guia especializado com histórias da região",
    "Antecedência mínima: 48 horas antes do horário da reserva"
  ]
};

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo}. Valor: R$ ${passeio.preco.toFixed(2).replace('.', ',')} por pessoa. Reserva antecipada de 48h obrigatória.`;
const whatsappUrl = `https://wa.me/${whatsappAgencia}?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} - ${passeio.subtitulo} | Serra Nevada Gramado Turismo - Gramado RS`}
  description="Tour Linha Bella: história, cultura e sabores da Serra Gaúcha! Vinícola com degustação, Casarão Marcon, Bodegão Bof e almoço italiano completo na Cantina Linha Bella. Antecedência mínima 48 horas!"
  keywords={['Tour Linha Bella', 'Cantina Linha Bella Gramado', 'passeio almoço italiano Gramado', 'Casarão família Marcon Gramado', 'Bodegão família Bof Gramado', 'degustação vinhos Gramado', 'passeio cultura italiana Gramado', 'Serra Nevada Gramado Turismo']}
  image={passeio.galeria[0]}
  canonical="/tour-linha-bella"
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-48 lg:h-[350px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-attachment: fixed; background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-medium rounded-full mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-3xl lg:text-5xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl text-gray-200">{passeio.subtitulo}</p>
          <div class="mt-6 flex items-center justify-center gap-4 flex-wrap">
            <div class="flex items-center gap-2">
              <StarRating rating={passeio.avaliacao} />
              <span class="text-sm text-gray-100">{passeio.avaliacao.toFixed(2)} · {passeio.totalAvaliacoes} avaliações</span>
            </div>
            <span class="px-3 py-1 bg-accent-500 text-dark rounded-full text-sm font-bold">
              {passeio.parcelas} R$ {passeio.preco.toFixed(2).replace('.', ',')}
            </span>
          </div>
        </div>
      </div>

      <!-- Divisor Boleado Suave -->
      <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-20">
        <svg 
          viewBox="0 0 1200 120" 
          preserveAspectRatio="none" 
          class="relative block w-[calc(100%+1.3px)] h-[30px] lg:h-[50px]"
        >
          <path d="M0,0 C300,120 900,120 1200,0 L1200,120 L0,120 Z" class="fill-white dark:fill-gray-900"></path>
        </svg>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">

          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre este passeio</h2>
            <p class="text-gray-700 leading-relaxed mb-4">{passeio.descricao}</p>
            <div class="bg-amber-50 border-l-4 border-accent-500 p-4 rounded-r-lg">
              <p class="text-gray-700 leading-relaxed text-sm">
                <strong class="text-primary-700">Importante:</strong> {passeio.descricaoExtra}
              </p>
            </div>
          </div>

          <!-- Roteiro do Passeio -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Como funciona o passeio</h3>
            <div class="space-y-4">
              {passeio.roteiro.map((item, index) => (
                <div class="flex items-start space-x-3">
                  <div class="flex-shrink-0 w-6 h-6 bg-primary-600 text-white rounded-full flex items-center justify-center text-sm font-bold">
                    {index + 1}
                  </div>
                  <p class="text-gray-700 leading-relaxed">{item}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que está incluso</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-start space-x-3">
                  <div class="flex-shrink-0 w-1 h-5 bg-green-500 rounded-full mt-1.5"></div>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tags / Destaques -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Destaques</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Valores -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Valores</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-gradient-to-br from-primary-50 to-amber-50 border border-primary-200 rounded-2xl p-6 shadow-sm">
                <div class="text-xs uppercase tracking-widest text-primary-700 font-bold mb-1">Por pessoa</div>
                <div class="text-3xl lg:text-4xl font-extrabold text-primary-700 mb-1">
                  R$ {passeio.preco.toFixed(2).replace('.', ',')}
                </div>
                <div class="text-sm text-gray-600">Almoço completo + todas as degustações + transporte + guia</div>
              </div>
              <div class="bg-gradient-to-br from-amber-50 to-yellow-50 border border-amber-300 rounded-2xl p-6 shadow-sm">
                <div class="text-xs uppercase tracking-widest text-amber-700 font-bold mb-1">Antecedência mínima</div>
                <div class="text-2xl lg:text-3xl font-extrabold text-amber-700 mb-2">
                  48 horas
                </div>
                <div class="text-sm text-gray-700 mb-3">Reserva antecipada obrigatória · Lugares limitados</div>
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-amber-600 text-white font-bold text-sm hover:bg-amber-700 transition-colors"
                >
                  Consultar disponibilidade
                </a>
              </div>
            </div>
          </div>

          <!-- Galeria de Imagens -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Galeria</h3>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
              {passeio.galeria.map((imagem, index) => (
                <div class="aspect-video overflow-hidden rounded-lg cursor-pointer hover:opacity-80 transition-opacity">
                  <img 
                    src={imagem} 
                    alt={`${passeio.titulo} - Imagem ${index + 1}`}
                    class="w-full h-full object-cover"
                    onclick={`openModal('${imagem}')`}
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>

          <!-- Observações Importantes -->
          <div class="mb-8 bg-yellow-50 p-6 rounded-xl">
            <h3 class="text-xl font-bold mb-4 text-yellow-800">Observações Importantes</h3>
            <ul class="space-y-2 text-yellow-700">
              <li class="flex items-start space-x-2">
                <div class="flex-shrink-0 w-1 h-5 bg-yellow-500 rounded-full mt-1.5"></div>
                <span><strong>Antecedência mínima:</strong> 48 horas em relação ao horário da reserva. Reservas de última hora sujeitas à disponibilidade.</span>
              </li>
              <li class="flex items-start space-x-2">
                <div class="flex-shrink-0 w-1 h-5 bg-yellow-500 rounded-full mt-1.5"></div>
                <span><strong>Reserva obrigatória:</strong> Vagas limitadas por dia. Recomendamos reservar com antecedência para garantir seu lugar.</span>
              </li>
              <li class="flex items-start space-x-2">
                <div class="flex-shrink-0 w-1 h-5 bg-yellow-500 rounded-full mt-1.5"></div>
                <span><strong>Almoço coletivo:</strong> O almoço na Cantina Linha Bella é compartilhado com participantes do PASSEIO LINHA BELLA, com música, dança e brincadeiras tradicionais italianas.</span>
              </li>
              <li class="flex items-start space-x-2">
                <div class="flex-shrink-0 w-1 h-5 bg-yellow-500 rounded-full mt-1.5"></div>
                <span><strong>Opção apenas almoço:</strong> É possível adquirir somente o almoço na Cantina Linha Bella, sem participar do passeio de visitações. Consulte valores e disponibilidade no WhatsApp.</span>
              </li>
              <li class="flex items-start space-x-2">
                <div class="flex-shrink-0 w-1 h-5 bg-yellow-500 rounded-full mt-1.5"></div>
                <span><strong>Horário de saída:</strong> Aproximadamente 07:30, com busca na sua hospedagem em Gramado ou Canela (zona urbana). Retorno previsto para 15:00.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Sidebar de Reserva -->
        <div class="lg:col-span-1">
          <div class="sticky top-24">
            <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-lg">
              <FormReserva
                passeioNome={passeio.titulo}
                passeioParcelas={passeio.parcelas}
                passeioPreco={passeio.preco}
                passeioPreco1={passeio.preco}
                passeioPreco2={passeio.preco}
                passeioLabel1="Por pessoa"
                passeioLabel2="Reserva 48h"
                passeioTemFaixas={false}
                passeioDuracao={passeio.duracao}
                passeioHorarios={passeio.horarios}
                passeioCategoria={passeio.categoria}
                passeioTemQuantidadePorPessoa={true}
                passeioValorPorPessoa={passeio.preco}
              />
              <div class="border-t border-gray-100 mt-6 pt-5 space-y-3">
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2 w-full px-4 py-3 rounded-lg bg-[#25D366] text-white font-bold text-base shadow-sm hover:bg-[#128C7E] hover:shadow-md transition-all"
                >
                  Fale no WhatsApp
                </a>
                <p class="text-xs text-center text-gray-500 leading-relaxed">
                  Atendimento direto com nossa equipe para dúvidas, disponibilidade, opção de só almoço ou grupos.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal para Galeria -->
  <div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="relative max-w-5xl max-h-full w-full">
      <button 
        onclick="closeModal()"
        class="absolute -top-10 right-0 text-white hover:text-gray-300 text-2xl"
        aria-label="Fechar galeria"
      >
        ✕
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-[85vh] object-contain rounded-lg mx-auto block" />
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  function openModal(imageSrc) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = imageSrc;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.getElementById('imageModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
  });
</script>
