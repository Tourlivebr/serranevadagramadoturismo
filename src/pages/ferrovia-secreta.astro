---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StarRating from '../components/StarRating.astro';

const passeio = {
  titulo: "Ferrovia Secreta Hector",
  subtitulo: "Sequência de Comida Americana no Trem Mágico",
  categoria: "INGRESSOS E ATRAÇÕES",
  avaliacao: 4.9,
  totalAvaliacoes: 0,
  linkOficial: "https://ferroviasecreta.hectordragao.com.br?ac=DQ8YMF9ULH",
  descricao: "Embarque em um trem mágico pelo mundo do dragão Hector! A Ferrovia Secreta é uma experiência gastronômica imersiva onde o salão imita o interior de um vagão com projeções nas janelas simulando viagem por reinos encantados. Antes do embarque há apresentação de mágica com o Edgar Faísca. O serviço de bordo de 1ª Classe traz sequência de comida americana dividida em etapas.",
  inclusos: [
    "Sequência de comida americana completa",
    "Aperitivos: Bastonetes da Crocância Eterna (batatas fritas), Cubinhos Incandescentes (dadinhos tapioca), Brotos dos Micronianos (coxinhas), Argolas Crocantes (onion rings), Ribs Barbecue (costelinha)",
    "Feitiço de Molhos Infinitos: cheddar, farofa de bacon, geleia de pimenta, barbecue",
    "Globos de Sabor: hambúrguer artesanal escolhido",
    "Feitiço Doce: Argolas Doces (donuts)",
    "Apresentação de mágica pré-embarque",
    "Serviço de bordo 1ª Classe com projeções e personagens"
  ],
  duracao: "2h30 (por viagem)",
  horarios: ["Consulte sessões no site oficial"],
  endereco: "Av. Borges de Medeiros, 2875 — Centro, Gramado/RS",
  galeria: [
    "/images/ferrovia hector.webp",
    "https://assets.planne.com.br/apps/63ASPFXWG3T/images/_/A9DuNfg6bZenrbXxFVcJuG2zUpBrVMCcJqs0eesD.jpg",
    "https://assets.planne.com.br/apps/63ASPFXWG3T/images/thumbnail/0rNWEyzw1ZvuNrM4YDvpCFC3px4uqsTJqV303tB4.jpg",
    "https://assets.planne.com.br/apps/63ASPFXWG3T/images/_/WpdShRrjX18XrRCm8lOAXuJqmAEULWYI1vBCfFyE.jpg",
    "https://assets.planne.com.br/apps/63ASPFXWG3T/images/_/A9DuNfg6bZenrbXxFVcJuG2zUpBrVMCcJqs0eesD.jpg",
    "https://assets.planne.com.br/apps/63ASPFXWG3T/images/thumbnail/0rNWEyzw1ZvuNrM4YDvpCFC3px4uqsTJqV303tB4.jpg"
  ],
  tags: [
    "Trem mágico Hector",
    "Comida americana",
    "Serviço de bordo 1ª classe",
    "Apresentação de mágica",
    "Projeções imersivas"
  ]
};

const whatsappMessage = `Olá! Gostaria de mais informações sobre o ${passeio.titulo} - ${passeio.subtitulo}.`;
const whatsappUrl = `https://wa.me/5554999411358?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout 
  title={`${passeio.titulo} - Ingresso | Serra Nevada Gramado Turismo - Gramado RS`}
  description="Ingresso para Ferrovia Secreta Hector! Experiência gastronômica no trem mágico com comida americana, mágica e projeções imersivas em Gramado/RS."
  keywords={['Ferrovia Secreta Hector', 'ingresso Ferrovia Secreta', 'trem mágico Gramado', 'comida americana Gramado', 'mágica Edgar Faísca', 'Serra Nevada Gramado Turismo']}
  image={passeio.galeria[0]}
>
  <Header />
  
  <main class="pt-20 lg:pt-24">
    <!-- Hero Section -->
    <section class="relative h-96 lg:h-[500px] overflow-hidden" style={`background-image: url('${passeio.galeria[0]}'); background-attachment: fixed; background-size: cover; background-position: center; background-repeat: no-repeat;`}>
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center text-white px-4">
          <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-medium rounded-full mb-4">
            {passeio.categoria}
          </span>
          <h1 class="text-4xl lg:text-6xl font-bold mb-4">{passeio.titulo}</h1>
          <p class="text-xl lg:text-2xl text-gray-200">{passeio.subtitulo}</p>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- Conteúdo Principal -->
        <div class="lg:col-span-3">

          <!-- Descrição -->
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Sobre esta atração</h2>
            <p class="text-gray-700 leading-relaxed">{passeio.descricao}</p>
          </div>

          <!-- O que está incluso -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">O que está incluso</h3>
            <ul class="space-y-2">
              {passeio.inclusos.map(item => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Duração e Horários -->
          <div class="mb-8 grid md:grid-cols-2 gap-6">
            <div class="bg-gray-50 p-6 rounded-lg">
              <h3 class="text-xl font-bold mb-3">Duração</h3>
              <p class="text-gray-700">{passeio.duracao}</p>
            </div>
            <div class="bg-gray-50 p-6 rounded-lg">
              <h3 class="text-xl font-bold mb-3">Horários</h3>
              <ul class="space-y-1">
                {passeio.horarios.map(horario => (
                  <li class="text-gray-700">🕐 {horario}</li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Tags -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Destaques</h3>
            <div class="flex flex-wrap gap-2">
              {passeio.tags.map(tag => (
                <span class="px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Botões CTA -->
          <div class="mb-8">
            <div class="grid md:grid-cols-2 gap-4">
              <a 
                href={passeio.linkOficial} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white font-bold text-lg rounded-lg shadow-lg transition-all hover:shadow-xl transform hover:-translate-y-0.5"
              >
                🎟️ Comprar ingresso oficial
              </a>
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-lg shadow-lg transition-all hover:shadow-xl transform hover:-translate-y-0.5"
              >
                💬 Falar com atendente no WhatsApp
              </a>
            </div>
          </div>

          <!-- Endereço -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Localização</h3>
            <div class="bg-gray-50 p-6 rounded-lg flex items-start space-x-4">
              <div class="flex-shrink-0">
                <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-800">Endereço</h4>
                <p class="text-gray-700">{passeio.endereco}</p>
              </div>
            </div>
          </div>

          <!-- Galeria de Imagens -->
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-4">Galeria</h3>
            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
              {passeio.galeria.map((imagem, index) => (
                <div class="aspect-square overflow-hidden rounded-lg cursor-pointer hover:opacity-80 transition-opacity">
                  <img 
                    src={imagem} 
                    alt={`${passeio.titulo} - Imagem ${index + 1}`}
                    class="w-full h-full object-cover"
                    onclick={`openModal('${imagem}')`}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Modal para Galeria -->
  <div id="imageModal" class="fixed inset-0 bg-black/80 z-50 hidden items-center justify-center p-4">
    <div class="relative max-w-4xl max-h-full">
      <button 
        onclick="closeModal()"
        class="absolute -top-10 right-0 text-white hover:text-gray-300 text-2xl"
      >
        ✕
      </button>
      <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  function openModal(imageSrc) {
    const modal = document.getElementById('imageModal');
    const modalImage = document.getElementById('modalImage');
    modalImage.src = imageSrc;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeModal() {
    const modal = document.getElementById('imageModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  document.getElementById('imageModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeModal();
    }
  });
</script>
