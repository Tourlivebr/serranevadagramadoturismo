  }

  function initCarouselIngressos() {
    let currentSlide = 0;
    const container = document.getElementById('carousel-container');
    const viewport = document.getElementById('carousel-viewport-ingressos');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const indicatorsContainer = document.getElementById('indicators');

    if (!container || !indicatorsContainer) return;
    let isAnimating = false;

    function isMobile() {
      return window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
    }

    function getSlidesPerView() {
      if (window.innerWidth >= 1280) return 4;
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }
    
    function getTotalSlides() {
      const totalItems = container.children.length;
      const slidesPerView = getSlidesPerView();
      return Math.max(1, totalItems - slidesPerView + 1);
    }

    function updateIndicators() {
      const totalSlides = getTotalSlides();
      const mobile = isMobile();
      indicatorsContainer.innerHTML = '';
      
      for (let i = 0; i < totalSlides; i++) {
        const indicator = document.createElement('button');
        const active = i === currentSlide;
        if (mobile) {
          indicator.className = `h-1.5 rounded-full transition-all duration-300 ease-out touch-manipulation ${
            active
              ? 'w-8 bg-primary-600 shadow-sm shadow-primary-600/40'
              : 'w-2 bg-gray-300 dark:bg-dark-600'
          }`;
        } else {
          indicator.className = `h-2 w-2 rounded-full transition-colors duration-200 touch-manipulation ${
            active ? 'bg-primary-600' : 'bg-gray-300 dark:bg-dark-600'
          }`;
        }
        indicator.setAttribute('aria-label', `Ir para slide ${i + 1}`);
        indicator.addEventListener('click', () => {
          if (isAnimating) return;
          currentSlide = i;
          updateCarousel();
        });
        indicatorsContainer.appendChild(indicator);
      }
    }
    
    function updateCarousel() {
      isAnimating = true;
      const firstItem = container.children[0];
      const itemWidth = firstItem ? firstItem.getBoundingClientRect().width : 0;
      container.style.transform = `translate3d(-${currentSlide * itemWidth}px, 0, 0)`;

      const totalSlides = getTotalSlides();
      if (prevBtn) prevBtn.style.opacity = currentSlide === 0 ? '0.6' : '1';
      if (nextBtn) nextBtn.style.opacity = currentSlide >= totalSlides - 1 ? '0.6' : '1';

      updateIndicators();
      setTimeout(() => { isAnimating = false; }, 900);
    }
    
    function createIndicators() {
      updateIndicators();
    }
    
    function initCarousel() {
      createIndicators();
      updateCarousel();
    }

    function nextSlide() {
      if (isAnimating) return;
      const totalSlides = getTotalSlides();
      currentSlide = currentSlide < totalSlides - 1 ? currentSlide + 1 : 0;
      updateCarousel();
    }

    function prevSlide() {
      if (isAnimating) return;
      const totalSlides = getTotalSlides();
      currentSlide = currentSlide > 0 ? currentSlide - 1 : totalSlides - 1;
      updateCarousel();
    }

    let autoPlayInterval;
    function startAutoPlay() {
      stopAutoPlay();
      const mobile = isMobile();
      const interval = mobile ? 11000 : 8000; // <=== MOBILE MAIS LENTO: 11s vs desktop 8s
      autoPlayInterval = setInterval(() => {
        if (document.hidden || document.visibilityState === 'hidden') return;
        nextSlide();
      }, interval);
    }
    
    function stopAutoPlay() {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
        autoPlayInterval = undefined;
      }
    }

    prevBtn?.addEventListener('click', prevSlide);
    nextBtn?.addEventListener('click', nextSlide);

    container.addEventListener('mouseenter', stopAutoPlay);
    container.addEventListener('mouseleave', startAutoPlay);

    if (container) {
      container.style.touchAction = 'pan-y';
    }

    // Swipe touch MELHORADO (eixo X vs Y + drag ao vivo)
    let startX = 0;
    let startY = 0;
    let isDragging = false;
    let deltaX = 0;
    let deltaY = 0;
    let startTime = 0;
    let axisLocked = false;
    let isHorizontal = false;

    container.addEventListener('touchstart', (e) => {
      if (!e.touches || e.touches.length === 0) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      deltaX = 0;
      deltaY = 0;
      isDragging = true;
      axisLocked = false;
      isHorizontal = false;
      startTime = Date.now();
      stopAutoPlay();
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      if (!isDragging || !e.touches || e.touches.length === 0) return;
      const cx = e.touches[0].clientX;
      const cy = e.touches[0].clientY;
      deltaX = startX - cx;
      deltaY = Math.abs(startY - cy);

      if (!axisLocked) {
        const dxAbs = Math.abs(deltaX);
        if (dxAbs > 10 || deltaY > 10) {
          axisLocked = true;
          isHorizontal = dxAbs >= deltaY;
        }
      }
      // Nao interrompa scroll vertical
      if (axisLocked && !isHorizontal) {
        isDragging = false;
        return;
      }
      // Feedback visual do drag no mobile
      if (axisLocked && isHorizontal && isMobile()) {
        const firstItem = container.children[0];
        const itemWidth = firstItem ? firstItem.getBoundingClientRect().width : 200;
        const base = currentSlide * itemWidth;
        const overflow = Math.abs(deltaX) > itemWidth ? (deltaX > 0 ? 1 : -1) * itemWidth * 0.2 : 0;
        container.style.transform = `translate3d(-${base + deltaX - overflow}px, 0, 0)`;
      }
    }, { passive: true });
    
    container.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      const elapsed = Date.now() - startTime;
      const absDx = Math.abs(deltaX);
      const firstItem = container.children[0];
      const itemWidth = firstItem ? firstItem.getBoundingClientRect().width : 200;

      const triggerSwipe = axisLocked && isHorizontal && (
        absDx >= itemWidth * 0.2 || (elapsed < 280 && absDx >= 30)
      );

      if (triggerSwipe && absDx > 0) {
        if (deltaX > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      } else if (isMobile()) {
        updateCarousel();
      }
      
      deltaX = 0;
      isDragging = false;
      axisLocked = false;
      isHorizontal = false;
      
      setTimeout(() => {
        startAutoPlay();
      }, isMobile() ? 6000 : 1500);
    }, { passive: true });

    // Pausa AUTOMATICAMENTE quando aba esta oculta (economia bateria)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoPlay();
      else startAutoPlay();
    });

    // Pausa em qualquer toque do usuario mobile
    viewport?.addEventListener('touchstart', stopAutoPlay, { passive: true });
    viewport?.addEventListener('touchcancel', stopAutoPlay, { passive: true });

    // ============== DESKTOP: SCROLL WHEEL no CARROSSEL (nunca mais trava a rolagem) ==============
    // Antes: passar o mouse sobre o carrossel com overflow-hidden + transition longa
    // capturava o evento "wheel" e ficava travado. Agora:
    //  - Shift + Scroll (ou trackpad horizontal / Magic Mouse) avança/retrocede slide
    //  - Scroll vertical SEMPRE propaga para o body (nunca trava tela)
    let lastWheelSlide = 0;
    function onWheelDesktop(evt) {
      // Não fazer nada durante animação (evita double trigger e nao previne rolagem)
      if (isAnimating) return;
      const dx = Math.abs(evt.deltaX);
      const dy = Math.abs(evt.deltaY);
      // Scroll HORIZONTAL (shift + wheel, trackpad, Magic Mouse) => troca slide
      const isHorizontal = (dx > dy) || (evt.shiftKey && dy > 0);
      if (isHorizontal) {
        if (Date.now() - lastWheelSlide < 450) return; // throttle
        const isAnimating = true;
        lastWheelSlide = Date.now();
        if (evt.deltaX > 1 || evt.deltaY > 1) {
          nextSlide();
        } else {
          prevSlide();
        }
        setTimeout(() => { isAnimating = false; }, 900);
      }
      // Qualquer wheel VERTICAL (sem shift) => deixa PROPAGAR PARA O BODY, rola a página normalmente)
      // NÃO USE evt.preventDefault()! = principal fix do "não consigo rolar"
    }

    if (viewport) {
      viewport.addEventListener('wheel', onWheelDesktop, { passive: true });
    }

    let resizeTimer = null;
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        currentSlide = 0;
        initCarousel();
      }, 180);
    });

    initCarousel();
    startAutoPlay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarouselIngressos);
  } else {
    initCarouselIngressos();
  }
</script>
