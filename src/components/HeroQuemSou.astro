---
// Nenhuma lógica do servidor necessária
---

<section
  id="quem-sou"
  class="relative min-h-[92vh] lg:min-h-[88vh] flex items-start lg:items-center overflow-hidden pt-20 lg:pt-28"
>
  <!-- =====================================================
       FUNDO PRINCIPAL
  ====================================================== -->
  <div
    class="absolute inset-0 z-0 bg-cover bg-center"
    style="background-image: url('/images/Fundo_gramado1.png');"
  ></div>

  <!-- Overlay para melhorar legibilidade -->
  <div
    class="absolute inset-0 z-[5]
           bg-gradient-to-b from-black/30 via-black/10 to-transparent
           lg:bg-gradient-to-r lg:from-black/55 lg:via-black/25 lg:to-transparent"
  ></div>

  <!-- =====================================================
       MASCOTE DESKTOP
  ====================================================== -->
  <div
    class="hidden lg:flex absolute bottom-0
           lg:right-[8%]
           xl:right-[11%]
           2xl:right-[14%]
           z-[10]
           w-[390px]
           xl:w-[450px]
           2xl:w-[490px]
           justify-end items-end
           pointer-events-none"
  >
    <img
      src="/images/mascote_serra_nevada1.png"
      alt="Mascote Serra Nevada"
      class="w-full h-auto object-contain
             drop-shadow-[0_30px_40px_rgba(0,0,0,0.35)]
             animate-bounce-slow"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- =====================================================
       MASCOTE MOBILE
       Mais centralizado e mais próximo do botão
  ====================================================== -->
  <div
    class="lg:hidden absolute
           bottom-[30px]
           left-1/2
           -translate-x-1/2
           z-[10]
           w-[68%]
           max-w-[320px]
           sm:w-[60%]
           sm:max-w-[360px]
           pointer-events-none"
  >
    <img
      src="/images/mascote_serra_nevada1.png"
      alt="Mascote Serra Nevada"
      class="mascote-mobile
             w-full h-auto object-contain
             drop-shadow-[0_22px_30px_rgba(0,0,0,0.28)]"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- =====================================================
       CONTEÚDO PRINCIPAL
  ====================================================== -->
  <div
    class="relative z-[20]
           container mx-auto
           px-4 lg:px-8
           pt-4 sm:pt-6
           pb-[14vh]
           sm:pb-[13vh]
           lg:pb-[8vh]"
  >
    <div
      class="grid grid-cols-1
             lg:grid-cols-12
             gap-8 lg:gap-6
             items-end"
    >
      <!-- COLUNA ESQUERDA -->
     

      <!-- Espaço visual à direita no desktop -->
      <div class="hidden lg:block lg:col-span-5"></div>
    </div>
  </div>

  <!-- =====================================================
       SETA DESKTOP
  ====================================================== -->
  <div
    class="hidden lg:flex
           absolute
           bottom-12
           left-1/2
           -translate-x-1/2
           z-[25]"
  >
    <a
      href="#passeios"
      class="text-white hover:text-accent-400 transition-colors animate-bounce"
      aria-label="Ir para passeios"
    >
      <svg
        class="w-10 h-10"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"
        />
      </svg>
    </a>
  </div>

  <!-- =====================================================
       ARCO INFERIOR
  ====================================================== -->
  <div
    class="absolute
           bottom-0
           left-0
           w-full
           overflow-hidden
           leading-[0]
           z-[30]
           pointer-events-none"
  >
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      class="relative
             block
             w-[calc(100%+1.3px)]
             h-[48px]
             sm:h-[58px]
             lg:h-[85px]"
    >
      <path
        d="M0,0 C300,120 900,120 1200,0 L1200,120 L0,120 Z"
        class="fill-gray-50 dark:fill-dark-900"
      />
    </svg>
  </div>
</section>

<style>
  /* =====================================================
     ANIMAÇÃO DE ENTRADA
  ====================================================== */
  @keyframes zoom-in {
    0% {
      transform: scale(1.12);
      opacity: 0;
    }

    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  .animate-zoom-in {
    animation: zoom-in 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    opacity: 0;
  }

  /* =====================================================
     ANIMAÇÃO DESKTOP
  ====================================================== */
  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(10%);
    }

    50% {
      transform: translateY(calc(10% - 10px));
    }
  }

  .animate-bounce-slow {
    animation: bounce-slow 3.5s ease-in-out infinite;
    transform-origin: center bottom;
  }

  /* =====================================================
     ANIMAÇÃO MOBILE
     Mais suave e mais elegante
  ====================================================== */
  @keyframes bounce-slow-mobile {
    0%,
    100% {
      transform: translateY(2%);
    }

    50% {
      transform: translateY(calc(2% - 7px));
    }
  }

  .mascote-mobile {
    animation: bounce-slow-mobile 3.8s ease-in-out infinite;
    transform-origin: center bottom;
  }

  /* =====================================================
     AJUSTES FINOS PARA TELAS MUITO PEQUENAS
  ====================================================== */
  @media (max-width: 420px) {
    .mascote-mobile {
      width: 100%;
      max-width: none;
    }
  }
</style>