---
interface FaixaPreco {
  label: string;
  preco: number;
}
interface Props {
  passeioNome: string;
  passeioParcelas?: string;
  passeioPreco?: number;
  passeioPreco1?: number;
  passeioPreco2?: number;
  passeioLabel1?: string;
  passeioLabel2?: string;
  passeioTemFaixas?: boolean;
  passeioDuracao?: string;
  passeioHorarios?: string[];
  passeioCategoria?: string;
  passeioFaixasCompletas?: FaixaPreco[];
  passeioTemTabelaCompleta?: boolean;
  passeioTemQuantidadePorPessoa?: boolean;
  passeioValorPorPessoa?: number;
}
const {
  passeioNome,
  passeioParcelas,
  passeioPreco,
  passeioPreco1,
  passeioPreco2,
  passeioLabel1,
  passeioLabel2,
  passeioTemFaixas = false,
  passeioDuracao,
  passeioHorarios,
  passeioCategoria,
  passeioFaixasCompletas,
  passeioTemTabelaCompleta = false,
  passeioTemQuantidadePorPessoa = false,
  passeioValorPorPessoa,
} = Astro.props;

const whatsappNumber = "5554999411358";

const temFaixasCompletas = passeioTemTabelaCompleta && Array.isArray(passeioFaixasCompletas) && passeioFaixasCompletas.length > 0;

const precoInicial = temFaixasCompletas
  ? passeioFaixasCompletas![0].preco
  : (passeioPreco1 !== undefined ? passeioPreco1 : (passeioPreco ?? 0));
const labelInicial = temFaixasCompletas
  ? passeioFaixasCompletas![0].label
  : (passeioLabel1 ?? passeioParcelas ?? '');

const formatarReal = (v: number) => `R$ ${v.toFixed(2).replace('.', ',')}`;

const faixasCompletasJSON = temFaixasCompletas ? JSON.stringify(passeioFaixasCompletas) : '';

const qtdPorPessoaInicial = passeioTemQuantidadePorPessoa ? 1 : 0;
const valorPorPessoaNumerico = passeioValorPorPessoa ?? passeioPreco ?? passeioPreco1 ?? 0;
const valorInicialQtdPessoas = passeioTemQuantidadePorPessoa ? valorPorPessoaNumerico * 1 : 0;
---

<div
  class="form-reserva-root"
  data-tem-faixas={passeioTemFaixas ? 'true' : 'false'}
  data-tem-faixas-completas={temFaixasCompletas ? 'true' : 'false'}
  data-preco1={passeioPreco1 ?? ''}
  data-preco2={passeioPreco2 ?? ''}
  data-label1={passeioLabel1 ?? ''}
  data-label2={passeioLabel2 ?? ''}
  data-faixas-completas={faixasCompletasJSON}
  data-tem-qtd-pessoa={passeioTemQuantidadePorPessoa ? 'true' : 'false'}
  data-valor-por-pessoa={valorPorPessoaNumerico}
>
  {(passeioDuracao || passeioHorarios || passeioCategoria) && (
  
    <h2 class="text-2xl font-bold mb-4">Faça sua Reserva:</h2>
    <div class="space-y-4 mb-5">
      {passeioDuracao && (
        <div class="flex justify-between">
          <span class="text-gray-600">Duração:</span>
          <span class="font-medium">{passeioDuracao}</span>
        </div>
      )}
      {passeioHorarios && passeioHorarios.length > 0 && (
        <div class="flex justify-between">
          <span class="text-gray-600">Horários:</span>
          <span class="font-medium">{passeioHorarios.join(', ')}</span>
        </div>
      )}
      {passeioCategoria && (
        <div class="flex justify-between">
          <span class="text-gray-600">Categoria:</span>
          <span class="font-medium">{passeioCategoria}</span>
        </div>
      )}
    </div>
  )}

  <!-- Seletor / Exibição de preço -->
  <div class="mb-5">
    {temFaixasCompletas && passeioFaixasCompletas ? (
      <div class="grid grid-cols-2 gap-2 mb-4">
        {passeioFaixasCompletas.map((fx, idx) => (
          <button
            type="button"
            data-faixa-idx={idx}
            class={`faixa-completa-btn sidebar-faixa-btn border-2 rounded-xl p-3 text-center shadow-sm transition-all hover:shadow-md ${idx === 0 ? 'border-primary-500 ring-2 ring-primary-500 bg-white' : 'border-gray-200 bg-white'}`}
          >
            <div class="text-gray-600 text-xs font-medium mb-1">{fx.label}</div>
            <div class="text-xl font-bold text-primary-600">{formatarReal(fx.preco)}</div>
          </button>
        ))}
      </div>
    ) : (passeioTemFaixas && passeioPreco1 !== undefined && passeioPreco2 !== undefined && passeioLabel1 && passeioLabel2) ? (
      <div class="grid grid-cols-2 gap-2 mb-4">
        <button type="button" data-faixa="1" class="faixa-pessoas-btn sidebar-faixa-btn border-2 border-primary-500 bg-white rounded-xl p-3 text-center shadow-sm transition-all hover:shadow-md ring-2 ring-primary-500">
          <div class="text-gray-600 text-xs font-medium mb-1">{passeioLabel1}</div>
          <div class="text-xl font-bold text-primary-600">{formatarReal(passeioPreco1)}</div>
        </button>
        <button type="button" data-faixa="2" class="faixa-pessoas-btn sidebar-faixa-btn border-2 border-gray-200 bg-white rounded-xl p-3 text-center shadow-sm transition-all hover:shadow-md">
          <div class="text-gray-600 text-xs font-medium mb-1">{passeioLabel2}</div>
          <div class="text-xl font-bold text-primary-600">{formatarReal(passeioPreco2)}</div>
        </button>
      </div>
    ) : null}

    <div class="text-center">
      <div class="text-gray-600 text-sm mb-1 form-reserva-label">
        {passeioTemQuantidadePorPessoa ? `${passeioParcelas ?? 'Por pessoa'} · ${formatarReal(valorPorPessoaNumerico)} cada` : (temFaixasCompletas || passeioTemFaixas ? labelInicial : passeioParcelas)}
      </div>
      <div class="text-3xl font-bold text-primary-600 form-reserva-valor">
        {formatarReal(passeioTemQuantidadePorPessoa ? valorInicialQtdPessoas : (temFaixasCompletas || passeioTemFaixas ? precoInicial : (passeioPreco ?? 0)))}
      </div>
      {passeioTemQuantidadePorPessoa && qtdPorPessoaInicial > 0 && (
        <div class="text-xs text-gray-500 mt-1 form-reserva-qtd-sumario">
          1 pessoa × {formatarReal(valorPorPessoaNumerico)}
        </div>
      )}
    </div>
  </div>

  <form class="space-y-4 form-reserva-form mb-4" onsubmit={`return window.__enviarReservaGeneric(event, String.raw\`${passeioNome}\`)`}>
    <h3 class="font-bold text-lg text-gray-900">Complete sua Reserva:</h3>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Nome:</label>
      <input type="text" required name="formNome" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" placeholder="Seu nome completo" />
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp:</label>
      <input type="tel" required name="formWhats" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" placeholder="(00) 00000-0000" />
    </div>

    {passeioTemQuantidadePorPessoa && (
      <div class="bg-primary-50/70 border border-primary-200/60 rounded-xl p-4 space-y-2">
        <label class="block text-sm font-bold text-primary-800 mb-1">
          Quantidade de pessoas:
        </label>
        <div class="flex items-center gap-3">
          <button type="button" data-qtd-acao="diminuir" class="w-11 h-11 rounded-lg bg-white border border-primary-300 text-primary-700 font-extrabold text-xl hover:bg-primary-100 active:scale-95 transition-all">-</button>
          <input
            type="number"
            min="1"
            max="200"
            value={qtdPorPessoaInicial}
            name="formQtdPessoas"
            data-qtd-input="true"
            class="w-full text-center px-3 py-2.5 border border-primary-300 bg-white rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-base font-bold text-primary-800"
          />
          <button type="button" data-qtd-acao="aumentar" class="w-11 h-11 rounded-lg bg-white border border-primary-300 text-primary-700 font-extrabold text-xl hover:bg-primary-100 active:scale-95 transition-all">+</button>
        </div>
        <p class="text-xs text-primary-700/80 leading-relaxed">
          Valor por pessoa: {formatarReal(valorPorPessoaNumerico)}. O valor total é recalculado automaticamente de acordo com a quantidade.
        </p>
      </div>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Hotel:</label>
        <input type="text" name="formHotel" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" placeholder="Nome do hotel / pousada" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Apartamento:</label>
        <input type="text" name="formApto" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" placeholder="Número do apartamento" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Passeio:</label>
      <input type="text" readonly name="formPasseio" class="w-full px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg text-gray-700 cursor-not-allowed" value={passeioNome} />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Data:</label>
        <input type="date" required name="formData" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Horário de saída <span class="text-gray-400 font-normal text-xs">(opcional)</span>:</label>
        <input type="time" name="formHoraSaida" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Observação:</label>
      <textarea name="formObs" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition resize-none" placeholder="Número de pessoas, ponto de encontro, horário, etc."></textarea>
    </div>

    <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition-colors flex items-center justify-center space-x-2">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
      <span>Enviar reserva</span>
    </button>
  </form>

  <a 
    class="form-reserva-contato w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3 px-6 rounded-lg transition-colors flex items-center justify-center space-x-2"
    data-base-text={`Olá! Gostaria de mais informações sobre o ${passeioNome}.`}
    data-whatsapp-direct="true"
    target="_blank"
    rel="noopener noreferrer"
    href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Olá! Gostaria de mais informações sobre o ${passeioNome}.${(temFaixasCompletas || passeioTemFaixas) ? ` ${labelInicial}: ${formatarReal(precoInicial)}.` : (passeioPreco !== undefined ? ` Valor: ${formatarReal(passeioPreco)}${passeioParcelas ? ` (${passeioParcelas})` : ''}.` : '')}`)}`}
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
    </svg>
    <span>Contato direto</span>
  </a>

  <div class="text-center mt-2">
    <p class="text-sm text-gray-600">Resposta rápida garantida!</p>
  </div>
</div>

<script>
  const WHATSAPP = "5554999411358";
  const fmt = (v) => `R$ ${(Number(v) || 0).toFixed(2).replace('.', ',')}`;

  if (!(window as any).__enviarReservaGeneric) {
    (window as any).__enviarReservaGeneric = function(event: Event, passeioNome: string) {
      event.preventDefault();
      const form = event.target as HTMLFormElement;
      const el = form.elements as any;
      const nome = el.formNome?.value?.trim() || '';
      const whats = el.formWhats?.value?.trim() || '';
      const hotel = el.formHotel?.value?.trim() || '';
      const apto = el.formApto?.value?.trim() || '';
      const qtdPessoasRaw = Number(el.formQtdPessoas?.value || 0);
      const passeio = el.formPasseio?.value?.trim() || passeioNome;
      const data = el.formData?.value || '';
      const horaSaida = el.formHoraSaida?.value || '';
      const obs = el.formObs?.value?.trim() || '';

      // Pega faixa selecionada (label e preço) a partir do sidebar pai
      let faixaLabel = '';
      let faixaValor = '';
      let rootTemQtdPessoa = false;
      const root = form.closest('.form-reserva-root');
      if (root) {
        const lbl = root.querySelector('.form-reserva-label') as HTMLElement | null;
        const vlr = root.querySelector('.form-reserva-valor') as HTMLElement | null;
        if (lbl?.textContent) faixaLabel = lbl.textContent.trim();
        if (vlr?.textContent) faixaValor = vlr.textContent.trim();
        rootTemQtdPessoa = (root as HTMLElement).dataset.temQtdPessoa === 'true';
      }

      const formatarData = (d: string) => {
        if (!d) return '';
        const [ano, mes, dia] = d.split('-');
        return `${dia}/${mes}/${ano}`;
      };

      const linhas = [
        `*Nova solicitação de reserva:*`,
        '',
        `*Nome:* ${nome}`,
        `*WhatsApp:* ${whats}`,
      ];
      if (hotel) linhas.push(`*Hotel:* ${hotel}`);
      if (apto) linhas.push(`*Apartamento:* ${apto}`);
      if (rootTemQtdPessoa && qtdPessoasRaw >= 1) {
        linhas.push(`*Quantidade de pessoas:* ${qtdPessoasRaw}`);
      }
      linhas.push(`*Passeio:* ${passeio}`);
      if (rootTemQtdPessoa && qtdPessoasRaw >= 1) {
        linhas.push(`*Valor por pessoa:* ${fmt(Number((root as any)?.dataset?.valorPorPessoa || 0))}`);
        linhas.push(`*Valor total:* ${faixaValor}`);
      } else if (faixaLabel && faixaValor) {
        linhas.push(`*Faixa:* ${faixaLabel}`);
        linhas.push(`*Valor:* ${faixaValor}`);
      }
      if (data) linhas.push(`*Data:* ${formatarData(data)}`);
      if (horaSaida) linhas.push(`*Horário de saída:* ${horaSaida}`);
      if (obs) linhas.push(`*Observação:* ${obs}`);

      const url = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(linhas.join('\n'))}`;
      window.open(url, '_blank');
      return false;
    };
  }

  // Inicializa o seletor do sidebar e escuta evento global vindo do seletor grande
  document.querySelectorAll('.form-reserva-root').forEach(root => {
    const temFaixas = (root as HTMLElement).dataset.temFaixas === 'true';
    const temFaixasCompletas = (root as HTMLElement).dataset.temFaixasCompletas === 'true';
    const temQtdPessoa = (root as HTMLElement).dataset.temQtdPessoa === 'true';
    const valorPorPessoa = Number((root as HTMLElement).dataset.valorPorPessoa || '0');

    const labelEl = root.querySelector('.form-reserva-label') as HTMLElement | null;
    const valorEl = root.querySelector('.form-reserva-valor') as HTMLElement | null;
    const contatoEl = root.querySelector('.form-reserva-contato') as HTMLAnchorElement | null;
    const qtdSumarioEl = root.querySelector('.form-reserva-qtd-sumario') as HTMLElement | null;
    const baseText = (contatoEl?.dataset as any)?.baseText || '';

    if (temQtdPessoa && valorPorPessoa > 0) {
      const qtdInput = root.querySelector<HTMLInputElement>('[data-qtd-input="true"]');
      const btnDiminuir = root.querySelector<HTMLButtonElement>('[data-qtd-acao="diminuir"]');
      const btnAumentar = root.querySelector<HTMLButtonElement>('[data-qtd-acao="aumentar"]');

      const recalcular = (qtd: number) => {
        const qtdSegura = Math.min(200, Math.max(1, Number.isNaN(qtd) ? 1 : qtd));
        const total = valorPorPessoa * qtdSegura;
        if (valorEl) valorEl.textContent = fmt(total);
        if (qtdSumarioEl) {
          qtdSumarioEl.textContent = `${qtdSegura} ${qtdSegura === 1 ? 'pessoa' : 'pessoas'} × ${fmt(valorPorPessoa)}`;
        }
        if (contatoEl) {
          const msg = `${baseText} ${qtdSegura} ${qtdSegura === 1 ? 'pessoa' : 'pessoas'} — total: ${fmt(total)} (${fmt(valorPorPessoa)} por pessoa).`;
          contatoEl.href = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
        }
        return qtdSegura;
      };

      const definirQtd = (novaQtd: number) => {
        const qtd = recalcular(novaQtd);
        if (qtdInput && Number(qtdInput.value) !== qtd) qtdInput.value = String(qtd);
      };

      if (qtdInput) {
        qtdInput.addEventListener('input', (e) => {
          const v = Number((e.target as HTMLInputElement).value);
          const qtd = recalcular(v);
          if (qtdInput && Number(qtdInput.value) !== qtd) qtdInput.value = String(qtd);
        });
        qtdInput.addEventListener('blur', (e) => {
          const v = Number((e.target as HTMLInputElement).value);
          definirQtd(v);
        });
      }
      btnDiminuir?.addEventListener('click', () => {
        const atual = Number(qtdInput?.value || '1');
        definirQtd(atual - 1);
      });
      btnAumentar?.addEventListener('click', () => {
        const atual = Number(qtdInput?.value || '1');
        definirQtd(atual + 1);
      });

      definirQtd(Number(qtdInput?.value || '1'));
      return;
    }

    if (!temFaixas && !temFaixasCompletas) return;

    let faixasList: Array<{label: string; preco: number}> = [];
    if (temFaixasCompletas) {
      try {
        const raw = (root as HTMLElement).dataset.faixasCompletas || '[]';
        faixasList = JSON.parse(raw);
      } catch (_) {
        faixasList = [];
      }
    }

    const p1 = Number((root as HTMLElement).dataset.preco1 || '0');
    const p2 = Number((root as HTMLElement).dataset.preco2 || '0');
    const l1 = (root as HTMLElement).dataset.label1 || '';
    const l2 = (root as HTMLElement).dataset.label2 || '';

    const btnsSidebar = root.querySelectorAll<HTMLButtonElement>('.sidebar-faixa-btn');

    const aplicarPrecoLabel = (preco: number, label: string) => {
      if (labelEl) labelEl.textContent = label;
      if (valorEl) valorEl.textContent = fmt(preco);
      if (contatoEl) {
        const msg = `${baseText} ${label}: ${fmt(preco)}.`;
        contatoEl.href = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
      }
    };

    const marcarBtnAtivo = (estaAtivoFn: (btn: HTMLButtonElement) => boolean) => {
      btnsSidebar.forEach(b => {
        const ativo = estaAtivoFn(b);
        b.classList.toggle('border-primary-500', ativo);
        b.classList.toggle('ring-2', ativo);
        b.classList.toggle('ring-primary-500', ativo);
        b.classList.toggle('border-gray-200', !ativo);
      });
    };

    // Ramo 1: multi-faixas (5 opções, ex: Maria Fumaça)
    if (temFaixasCompletas && faixasList.length > 0) {
      const aplicarIdx = (idx: number) => {
        const fx = faixasList[idx] || faixasList[0];
        aplicarPrecoLabel(fx.preco, fx.label);
        marcarBtnAtivo((b) => {
          const bi = Number(b.dataset.faixaIdx ?? '-1');
          return bi === idx;
        });
      };

      btnsSidebar.forEach(btn => {
        if (btn.dataset.faixaIdx === undefined) return;
        btn.addEventListener('click', () => {
          const idx = Number(btn.dataset.faixaIdx || '0');
          aplicarIdx(idx);
          window.dispatchEvent(new CustomEvent('faixa-completa-mudou', { detail: { idx } }));
        });
      });

      window.addEventListener('faixa-completa-mudou', ((e: CustomEvent) => {
        const idx = Number(e?.detail?.idx ?? 0);
        if (!Number.isNaN(idx)) aplicarIdx(idx);
      }) as EventListener);

      return;
    }

    // Ramo 2: 2 faixas (padrão)
    const aplicarFaixa = (faixa: '1' | '2') => {
      const preco = faixa === '1' ? p1 : p2;
      const label = faixa === '1' ? l1 : l2;
      aplicarPrecoLabel(preco, label);
      marcarBtnAtivo((b) => b.dataset.faixa === faixa);
    };

    btnsSidebar.forEach(btn => {
      if (!btn.dataset.faixa) return;
      btn.addEventListener('click', () => {
        const faixa = btn.dataset.faixa as '1' | '2';
        aplicarFaixa(faixa);
        window.dispatchEvent(new CustomEvent('faixa-pessoas-mudou', { detail: { faixa, origem: 'sidebar' } }));
      });
    });

    window.addEventListener('faixa-pessoas-mudou', ((e: CustomEvent) => {
      const faixa = e?.detail?.faixa as '1' | '2' | undefined;
      if (faixa) aplicarFaixa(faixa);
    }) as EventListener);
  });
</script>
